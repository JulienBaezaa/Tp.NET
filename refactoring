// 1. Le calcul dans sa propre classe (avec une interface)
public interface IDiscountCalculator
{
    decimal GetDiscountRate(decimal price, string category);
}

public class DiscountCalculator : IDiscountCalculator
{
    // constantes nommées à la place des nombres magiques
    private const decimal SeuilBas = 100m;
    private const decimal SeuilMoyen = 200m;
    private const decimal SeuilHaut = 500m;
    private const decimal BonusAccessoires = 0.05m;
    private const decimal PlafondEcrans = 0.10m;

    public decimal GetDiscountRate(decimal price, string category)
    {
        var baseRate = GetBaseRate(price);
        return category switch
        {
            "accessoires" => baseRate + BonusAccessoires,
            "ecrans"      => Math.Min(baseRate, PlafondEcrans),
            _             => baseRate
        };
    }

    private static decimal GetBaseRate(decimal price) => price switch
    {
        >= SeuilHaut  => 0.15m,
        >= SeuilMoyen => 0.10m,
        >= SeuilBas   => 0.05m,
        _             => 0m
    };
}

// 2. La validation sur le DTO
public class CreateProductRequest
{
    [Required, StringLength(100)]
    public string Name { get; set; } = "";

    [Range(0.01, double.MaxValue)]
    public decimal Price { get; set; }

    [Required, RegularExpression("^(accessoires|ecrans|autre)$")]
    public string Category { get; set; } = "";
}

// 3. Le contrôleur ne fait plus que recevoir et répondre
[ApiController]                       // renvoie 400 automatiquement si le DTO est invalide
[Route("api/products")]
public class ProductsController : ControllerBase
{
    private readonly AppDbContext _db;
    private readonly IDiscountCalculator _discount;

    public ProductsController(AppDbContext db, IDiscountCalculator discount)
    {
        _db = db;
        _discount = discount;
    }

    [HttpPost]
    public IActionResult Create(CreateProductRequest request)
    {
        var rate = _discount.GetDiscountRate(request.Price, request.Category);
        var product = new Product
        {
            Name = request.Name,
            Price = request.Price,
            Category = request.Category,
            FinalPrice = Math.Round(request.Price * (1 - rate), 2)
        };
        _db.Products.Add(product);
        _db.SaveChanges();
        return CreatedAtAction(nameof(GetById), new { id = product.Id }, product);
    }
}

